{
  "name": "sitekit",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog-driven static-page generator and browser audit gate for a supported room-style catalog contract.",
  "license": "Apache-2.0",
  "author": "Maria",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test \"tests/node/*.test.mjs\" && node scripts/test-python.mjs",
    "test:node": "node --test \"tests/node/*.test.mjs\"",
    "test:python": "node scripts/test-python.mjs",
    "audit": "node scripts/test-python.mjs -- audit.py"
  }
}
